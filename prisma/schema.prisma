// -------------------------------
// Fuente de datos y cliente Prisma
// -------------------------------
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------
// Enumeraciones
// -------------------------------
enum TipoVenta {
  COCHE
  PIEZAS
}

// -------------------------------
// MODELOS
// -------------------------------

model User {
  id          Int         @id @default(autoincrement())
  nombre      String
  apellidos   String
  dni         String      @unique
  email       String      @unique
  movil       String
  password    String
  direcciones Direccion[]
  compras     Compra[]
  rol         String      @default("User") // "User" o "Admin"
  favoritos   Favorito[] // Nueva relación
  refreshToken String?
}

model Direccion {
  id           Int    @id @default(autoincrement())
  calle        String
  numero       String
  ciudad       String
  provincia    String
  codigoPostal String
  pais         String
  clienteId    Int
  cliente      User   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  // Se añade "onDelete: Cascade" para eliminar direcciones si el usuario se borra
}

model Car {
  id             Int               @id @default(autoincrement())
  marca          String
  model          String
  consumo        Float
  combustible    String
  anoFabricacion Int
  cilindrada     Float
  precio         Float
  potencia       Float
  color          String
  matricula      String            @unique
  tipoVenta      TipoVenta
  defectos       Defecto[]
  imagenes       Imagen[]
  piezas         Pieza[]
  compras        Compra[]
  favoritos      Favorito[] // Nueva relación
  mensajes       MensajeContacto[]
  // ✅ coherencia total con relaciones: compras, defectos, imágenes y piezas
}

model Defecto {
  id          Int           @id @default(autoincrement())
  descripcion String
  numero      Int
  carId       Int
  car         Car           @relation(fields: [carId], references: [id], onDelete: Cascade)
  fotos       FotoDefecto[]
  // ✅ Añadido onDelete: Cascade — si se elimina un coche, también sus defectos
}

model FotoDefecto {
  id        Int     @id @default(autoincrement())
  lugar     String
  numero    Int
  defectoId Int
  defecto   Defecto @relation(fields: [defectoId], references: [id], onDelete: Cascade)
  // ✅ Cascade para limpieza automática de imágenes asociadas
}

model Imagen {
  id    Int    @id @default(autoincrement())
  url   String
  carId Int
  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
}

model Pieza {
  id          Int         @id @default(autoincrement())
  descripcion String
  precio      Float
  carId       Int
  car         Car         @relation(fields: [carId], references: [id], onDelete: Cascade)
  fotos       FotoPieza[]
  compras     Compra[]
}

model FotoPieza {
  id         Int    @id @default(autoincrement())
  parteCoche String
  numero     Int
  piezaId    Int
  pieza      Pieza  @relation(fields: [piezaId], references: [id], onDelete: Cascade)
}

model Compra {
  id        Int  @id @default(autoincrement())
  clienteId Int
  cliente   User @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  cocheId Int? // Puede ser null si la compra es de piezas
  coche   Car? @relation(fields: [cocheId], references: [id], onDelete: SetNull)

  piezaId Int? // Puede ser null si la compra es de coches
  pieza   Pieza? @relation(fields: [piezaId], references: [id], onDelete: SetNull)

  fecha    DateTime @default(now())
  cantidad Int      @default(1)
  total    Float
  // ✅ coherencia: "SetNull" evita que se borren compras al borrar el coche/pieza
}

model Favorito {
  id     Int      @id @default(autoincrement())
  userId Int
  carId  Int
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  car    Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  fecha  DateTime @default(now())

  @@unique([userId, carId]) // Evita duplicados en favoritos
}

model MensajeContacto {
  id       Int      @id @default(autoincrement())
  nombre   String
  email    String
  telefono String?
  mensaje  String
  carId    Int?
  car      Car?     @relation(fields: [carId], references: [id], onDelete: SetNull)
  fecha    DateTime @default(now())
}
